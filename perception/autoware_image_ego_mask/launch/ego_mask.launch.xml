<?xml version="1.0"?>
<launch>
  <arg name="input/image" default="/sensing/camera/camera6/image_raw"/>
  <arg name="output/image" default="/sensing/camera/camera6/image_raw_masked"/>

  <!-- Fill value applied inside polygons, interpreted as BGR [0..255] -->
  <arg name="fill_value_bgr" default="[0.0, 0.0, 0.0]"/>

  <!-- Path to YAML defining polygons (see config/example_polygons.yaml). Empty disables file load. -->
  <arg name="polygons_yaml_file" default="$(find-pkg-share autoware_image_ego_mask)/config/example_polygons.yaml"/>

  <node pkg="autoware_image_ego_mask" exec="ego_mask_node" name="ego_mask" output="screen">
    <param name="enabled" value="true"/>
    <param name="input_transport" value="raw"/>
    <param name="output_transport" value="raw"/>
    <param name="input_image_base_topic" value="$(var input/image)"/>
    <param name="output_image_base_topic" value="$(var output/image)"/>
    <param name="fill_value_bgr" value="$(var fill_value_bgr)"/>
    <param name="polygons_yaml_file" value="$(var polygons_yaml_file)"/>
  </node>
</launch>
